# Use your own credentials. Never commit .env.
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
DISCOVERY_USE_EXA=false
LLM_MODEL=openai/gpt-5.4-mini
# Optional per-stage overrides:
DISCOVERY_LLM_MODEL=
INGESTION_LLM_MODEL=

NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-research-password

# Local bundled prompts are the default; tracing requires your own key/project.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=ai-internship-public
PROMPT_SOURCE=local
# Optional JSON object mapping prompt slugs to bundled version identifiers.
PROMPT_VERSIONS={}

# Initial research can fetch up to 1,000 first-party pages. Adjust for your budget.
RESEARCH_FIRST_PARTY_PAGE_LIMIT=1000
RESEARCH_FETCH_CONCURRENCY=8
RESEARCH_EXTERNAL_FETCH_LIMIT=10
DISCOVERY_MAX_SEARCH_CALLS=25
DISCOVERY_MAX_SCRAPE_CALLS=15
DISCOVERY_MAX_MAP_CALLS=5
DISCOVERY_MAX_CRAWL_CALLS=5
DISCOVERY_MAX_CRAWL_PAGES=50
# Optional external-page judge; off by default. Adds reads/model calls.
DISCOVERY_EVIDENCE_JUDGE=false
# Comma-separated hostnames of reference publishers/mirrors to exclude as evidence.
# Set for your evaluation to prevent reading answers back from their publishers.
DISCOVERY_EXCLUDED_HOSTS=
